# Model used by the benchmark agent.
OPENAI_API_KEY=
AGENT_LLM=gpt-5.4
AGENT_REASONING_EFFORT=medium

# Optional OpenAI-compatible endpoint.
# AGENT_BASE_URL=http://localhost:8000/v1

# Optional path to the oh-my-pi executable.
# OMP_BIN=/path/to/omp

# Optional ITBench-AA data cache and judge override.
# ITBENCH_DATA=./data
# JUDGE_MODEL=gpt-5.4
